treeclean() {
  # Default directories to always prune
  local defaults=( bin obj dist dist-newstyle node_modules .git .cache .stack-work __pycache__ )

  # Add user-provided ones (if any)
  local prune_dirs=( "${defaults[@]}" "${@}" )

  # Build the find condition dynamically
  local cond=""
  for d in "${prune_dirs[@]}"; do
    [[ -n $cond ]] && cond+=" -o"
    cond+=" -name '$d'"
  done

  # If no directories to prune at all (should never happen), just print everything
  [[ -z $cond ]] && { find . -print | sort; return; }

  # Run find + pretty tree
  eval "find . -type d \( $cond \) -prune -o -print" 2>/dev/null |
    sort |
    sed -e 's|[^/]*/|  |g' \
        -e 's|  \([^ ]\)|└─\1|' \
        -e 's|  |│ |g' \
        -e 's|│ |  |g'
}
